---
import SectionHeading from "@/components/SectionHeading.astro";

const { key_features } = Astro.props;
const { title, description, feature_list } = key_features;
---

<section id="features" class="section scroll-mt-20 bg-white">
  <div class="container">
    <SectionHeading title={title} description={description} />

    <div class="mt-16 space-y-20 md:mt-24 md:space-y-32">
      {
        feature_list.map((item: any, i: number) => (
          <article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-16" data-reveal>
            <div class={`lg:col-span-7 ${i % 2 === 1 ? "lg:order-2" : ""}`}>
              <div class="aspect-[4/3] overflow-hidden rounded-sm bg-theme-light lg:aspect-[5/4]">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
            <div class={`lg:col-span-5 ${i % 2 === 1 ? "lg:order-1" : ""}`}>
              <p class="section-number">{String(i + 1).padStart(2, "0")}</p>
              <h3 class="mt-3 text-2xl leading-snug md:text-[2rem]">{item.title}</h3>
              <ul class="dot-list mt-6 space-y-3">
                {item.list.map((line: string) => (
                  <li>{line}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
