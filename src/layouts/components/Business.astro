---
import SectionHeading from "@/components/SectionHeading.astro";
import config from "@/config/config.json";
import Icon from "@/components/Icon.astro";
import { contactHref as buildContactHref, t } from "@/lib/i18n";

const { business } = Astro.props;
const { title, business_list } = business;
const text = t(Astro.url.pathname);
const contactHref = buildContactHref(Astro.url.pathname, config.params.email);
---

<section id="business" class="section scroll-mt-20">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28">
          <SectionHeading title={title} align="left" />
          <a href={contactHref} class="btn btn-outline mt-8" data-reveal>
            <Icon name="mail" class="btn-icon" md="hover inview" delay={250} />
            <span>{text.contact}</span>
          </a>
        </div>
      </div>

      <ol class="divide-y divide-border lg:col-span-8">
        {
          business_list.map((item: any, i: number) => (
            <li class="grid gap-3 py-8 first:pt-0 md:grid-cols-12 md:gap-6" data-reveal>
              <p class="section-number md:col-span-1 md:pt-1.5">{String(i + 1).padStart(2, "0")}</p>
              <div class="md:col-span-11">
                <h3 class="text-xl leading-snug md:text-2xl">{item.title}</h3>
                <p class="mt-3 max-w-2xl text-[15px] leading-[1.9]">{item.description}</p>
                {i < 2 && (
                  <a href={contactHref} class="btn-link mt-5">{text.askChannel}</a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
