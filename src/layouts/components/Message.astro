---
import SectionHeading from "@/components/SectionHeading.astro";

const { message, title, eyebrow = "Message", caption, image = "/images/ceo__.jpg" } = Astro.props;
const { Content } = await message.render();
---

<section id="message" class="section scroll-mt-20 bg-white">
  <div class="container">
    <SectionHeading title={title} eyebrow={eyebrow} />

    <div class="mt-14 grid items-start gap-10 md:mt-20 lg:grid-cols-12 lg:gap-16" data-reveal>
      <figure class="mx-auto w-full max-w-xs lg:col-span-4 lg:max-w-none">
        <div class="aspect-[4/5] overflow-hidden rounded-sm bg-theme-light">
          <img
            src={image}
            alt={caption}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-[72%_center]"
          />
        </div>
        {caption && <figcaption class="mt-3 text-[13px] tracking-[0.04em] text-light">{caption}</figcaption>}
      </figure>

      <div class="message-body lg:col-span-7 lg:col-start-6">
        <Content />
      </div>
    </div>
  </div>
</section>
