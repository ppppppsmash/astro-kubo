---
import SectionHeading from "@/components/SectionHeading.astro";

const { event, eyebrow = "Research" } = Astro.props;
const { title, description, projects } = event;
---

<section id="event" class="section scroll-mt-20 bg-white">
  <div class="container">
    <SectionHeading title={title} eyebrow={eyebrow} description={description} />

    <div class="mt-14 grid gap-x-12 gap-y-12 md:mt-20 md:grid-cols-3">
      {
        projects.map((item: any, i: number) => (
          <article data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <p class="section-number">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-3 text-xl leading-snug">{item.title}</h3>
            <p class="mt-4 text-[15px] leading-[1.9]">{item.content}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
