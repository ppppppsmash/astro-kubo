---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";
import config from "@/config/config.json";
import { getLocale, t } from "@/lib/i18n";

const { pathname } = Astro.url;
const locale = getLocale(pathname);
const items = locale === "tw" ? menu.tw : menu.main;
const text = t(pathname);
const contactHref = `mailto:${config.params.email}`;
---

<header class="header" data-menu="closed">
  <nav class="navbar container" aria-label="Main">
    <div class="order-0">
      <Logo />
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="nav-toggle order-2 lg:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={text.menuOpen}
      data-label-open={text.menuOpen}
      data-label-close={text.menuClose}
    >
      <svg class="nav-toggle-icon nav-toggle-icon-open h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 5h16M2 10h16M2 15h16" stroke-linecap="round" />
      </svg>
      <svg class="nav-toggle-icon nav-toggle-icon-close h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M4 4l12 12M16 4L4 16" stroke-linecap="round" />
      </svg>
    </button>

    <ul id="nav-menu" class="navbar-nav order-3 lg:order-1">
      {
        items.map((item) => (
          <li class="nav-item">
            <a href={item.url} class="nav-link">
              {item.name}
            </a>
          </li>
        ))
      }
      <li class="nav-item lg:ml-2">
        <a href={text.langSwitch.href} class="nav-link nav-lang" hreflang={locale === "tw" ? "ja" : "zh-Hant"}>
          {text.langSwitch.label}
        </a>
      </li>
      <li class="nav-item nav-item-cta lg:ml-4">
        <a href={contactHref} class="btn btn-primary btn-sm w-full lg:w-auto">{text.contact}</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  let controller: AbortController | null = null;

  function initHeader() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>(".header");
    if (!header) return;

    // --- mobile menu -------------------------------------------------------
    const toggle = header.querySelector<HTMLButtonElement>("#nav-toggle");
    const menu = header.querySelector<HTMLElement>("#nav-menu");
    const desktop = window.matchMedia("(min-width: 1024px)");
    const isOpen = () => header.dataset.menu === "open";

    const setOpen = (open: boolean) => {
      if (!toggle) return;
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute("aria-label", label);
    };

    if (toggle && menu) {
      toggle.addEventListener("click", () => setOpen(!isOpen()), { signal });

      // Tapping any link (anchor, language switch, contact) closes the menu.
      menu.addEventListener(
        "click",
        (e) => {
          if ((e.target as Element).closest("a")) setOpen(false);
        },
        { signal },
      );

      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );

      // Tap outside the panel (scrim, logo, page) closes it.
      document.addEventListener(
        "pointerdown",
        (e) => {
          if (!isOpen()) return;
          const target = e.target as Node;
          if (menu.contains(target) || toggle.contains(target)) return;
          setOpen(false);
        },
        { signal },
      );

      desktop.addEventListener("change", (e) => e.matches && setOpen(false), { signal });
    }

    // --- sticky state + scroll-spy ------------------------------------------

    // Links that point at a section on this page: "/#features", "/tw#service" ...
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>("#nav-menu a.nav-link:not(.nav-lang)"));
    const targets = links
      .map((link) => {
        const url = new URL(link.getAttribute("href") ?? "", location.origin);
        if (url.pathname.replace(/\/$/, "") !== location.pathname.replace(/\/$/, "")) return null;
        const section = url.hash ? document.getElementById(url.hash.slice(1)) : document.getElementById("banner");
        return section ? { link, section } : null;
      })
      .filter((t): t is { link: HTMLAnchorElement; section: HTMLElement } => t !== null);

    let ticking = false;
    const update = () => {
      ticking = false;
      header.classList.toggle("header-sticky", window.scrollY > 8);

      if (!targets.length) return;
      const probe = window.scrollY + window.innerHeight * 0.35;
      let current = targets[0];
      for (const t of targets) {
        if (t.section.offsetTop <= probe) current = t;
      }
      for (const t of targets) {
        const active = t === current;
        t.link.classList.toggle("active", active);
        if (active) t.link.setAttribute("aria-current", "location");
        else t.link.removeAttribute("aria-current");
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("resize", onScroll, { passive: true, signal });
    update();
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
