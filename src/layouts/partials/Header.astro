---
import Logo from "@/components/Logo.astro";
import menu from "@/config/menu.json";
import config from "@/config/config.json";
import Icon from "@/components/Icon.astro";
import { contactHref as buildContactHref, getLocale, languages, t } from "@/lib/i18n";

const { pathname } = Astro.url;
const locale = getLocale(pathname);
const items = locale === "tw" ? menu.tw : menu.main;
const text = t(pathname);
const contactHref = buildContactHref(pathname, config.params.email);
const currentLanguage = languages.find((l) => l.code === locale) ?? languages[0];
---

<header class="header" data-menu="closed">
  <nav class="navbar container" aria-label="Main">
    <div class="order-0">
      <Logo />
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="nav-toggle order-2 lg:hidden"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label={text.menuOpen}
      data-label-open={text.menuOpen}
      data-label-close={text.menuClose}
    >
      <Icon name="menu-to-close" class="nav-toggle-icon h-5 w-5" data-menu-icon="open" />
      <Icon name="close-to-menu" class="nav-toggle-icon hidden h-5 w-5" data-menu-icon="close" />
    </button>

    <ul id="nav-menu" class="navbar-nav order-3 lg:order-1">
      {
        items.map((item) => (
          <li class="nav-item">
            <a href={item.url} class="nav-link">
              {item.name}
            </a>
          </li>
        ))
      }
      <li class="nav-item lg:ml-2">
        <div class="lang" data-open="false">
          <button
            type="button"
            id="lang-toggle"
            class="lang-toggle"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="lang-menu"
            aria-label={text.language}
          >
            <Icon name="globe" class="lang-globe h-[18px] w-[18px]" md="hover menu" />
            <span class="lang-label">{currentLanguage.label}</span>
            <svg class="lang-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="lang-menu" class="lang-menu">
            <ul class="lang-list" role="menu" aria-label={text.language}>
              {
                languages.map((l) => (
                  <li role="none">
                    <a
                      role="menuitem"
                      href={l.href}
                      hreflang={l.hreflang}
                      lang={l.hreflang}
                      class="lang-option"
                      aria-current={l.code === locale ? "true" : undefined}
                      tabindex="-1"
                    >
                      <span>{l.label}</span>
                      <Icon name="check" class="lang-check h-3.5 w-3.5" md="lang" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </li>
      <li class="nav-item nav-item-cta lg:ml-4">
        <a href={contactHref} class="btn btn-primary btn-sm w-full lg:w-auto">
          <Icon name="mail" class="btn-icon" md="hover menu" />
          <span>{text.contact}</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  import { replay, hold, finish, reducedMotion } from "@/lib/linemd";

  let controller: AbortController | null = null;

  function initHeader() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const header = document.querySelector<HTMLElement>(".header");
    if (!header) return;

    // --- mobile menu -------------------------------------------------------
    const toggle = header.querySelector<HTMLButtonElement>("#nav-toggle");
    const menu = header.querySelector<HTMLElement>("#nav-menu");
    const desktop = window.matchMedia("(min-width: 1024px)");
    const isOpen = () => header.dataset.menu === "open";

    // hamburger ⇄ cross: two SMIL morphs, swap + rewind the one for this direction
    const iconOpen = header.querySelector<SVGSVGElement>('[data-menu-icon="open"]');
    const iconClose = header.querySelector<SVGSVGElement>('[data-menu-icon="close"]');
    const reduce = reducedMotion();
    if (iconOpen) hold(iconOpen);
    if (iconClose) finish(iconClose);
    const setMenuIcon = (open: boolean) => {
      if (!iconOpen || !iconClose) return;
      if (reduce) {
        iconOpen.classList.remove("hidden");
        iconClose.classList.add("hidden");
        iconOpen.pauseAnimations();
        iconOpen.setCurrentTime(open ? 60 : 0);
        return;
      }
      const show = open ? iconOpen : iconClose;
      const hide = open ? iconClose : iconOpen;
      hide.classList.add("hidden");
      show.classList.remove("hidden");
      replay(show);
    };

    const setOpen = (open: boolean) => {
      if (!toggle) return;
      const changed = (header.dataset.menu === "open") !== open;
      header.dataset.menu = open ? "open" : "closed";
      toggle.setAttribute("aria-expanded", String(open));
      const label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute("aria-label", label);
      if (changed) setMenuIcon(open);
      // icons inside the panel draw themselves in as it opens
      if (changed && open && !reduce && menu) {
        menu.querySelectorAll<SVGSVGElement>('svg[data-md~="menu"]').forEach(replay);
      }
    };

    if (toggle && menu) {
      toggle.addEventListener("click", () => setOpen(!isOpen()), { signal });

      // Tapping any link (anchor, language switch, contact) closes the menu.
      menu.addEventListener(
        "click",
        (e) => {
          if ((e.target as Element).closest("a")) setOpen(false);
        },
        { signal },
      );

      document.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape" && isOpen()) {
            setOpen(false);
            toggle.focus();
          }
        },
        { signal },
      );

      // Tap outside the panel (scrim, logo, page) closes it.
      document.addEventListener(
        "pointerdown",
        (e) => {
          if (!isOpen()) return;
          const target = e.target as Node;
          if (menu.contains(target) || toggle.contains(target)) return;
          setOpen(false);
        },
        { signal },
      );

      desktop.addEventListener("change", (e) => e.matches && setOpen(false), { signal });
    }

    // --- language dropdown --------------------------------------------------
    const lang = header.querySelector<HTMLElement>(".lang");
    const langToggle = header.querySelector<HTMLButtonElement>("#lang-toggle");
    const langOptions = Array.from(header.querySelectorAll<HTMLAnchorElement>(".lang-option"));
    const langOpen = () => lang?.dataset.open === "true";

    const setLangOpen = (open: boolean) => {
      if (!lang || !langToggle) return;
      const changed = langOpen() !== open;
      lang.dataset.open = String(open);
      langToggle.setAttribute("aria-expanded", String(open));
      if (changed && open && !reduce) {
        lang.querySelectorAll<SVGSVGElement>('svg[data-md~="lang"]').forEach(replay);
      }
    };

    if (lang && langToggle && langOptions.length) {
      const focusOption = (index: number) => {
        const i = (index + langOptions.length) % langOptions.length;
        langOptions[i].focus();
      };

      langToggle.addEventListener("click", () => setLangOpen(!langOpen()), { signal });

      langToggle.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "ArrowDown" || e.key === "ArrowUp") {
            e.preventDefault();
            setLangOpen(true);
            // wait for visibility to flip before moving focus
            requestAnimationFrame(() => focusOption(e.key === "ArrowDown" ? 0 : -1));
          }
        },
        { signal },
      );

      lang.addEventListener(
        "keydown",
        (e) => {
          if (!langOpen()) return;
          const i = langOptions.indexOf(document.activeElement as HTMLAnchorElement);
          if (e.key === "ArrowDown" && i >= 0) {
            e.preventDefault();
            focusOption(i + 1);
          } else if (e.key === "ArrowUp" && i >= 0) {
            e.preventDefault();
            focusOption(i - 1);
          } else if (e.key === "Escape") {
            e.preventDefault();
            e.stopPropagation();
            setLangOpen(false);
            langToggle.focus();
          } else if (e.key === "Tab") {
            setLangOpen(false);
          }
        },
        { signal },
      );

      document.addEventListener(
        "pointerdown",
        (e) => {
          if (langOpen() && !lang.contains(e.target as Node)) setLangOpen(false);
        },
        { signal },
      );

      // Closing the mobile panel also resets the dropdown.
      new MutationObserver(() => {
        if (header.dataset.menu === "closed") setLangOpen(false);
      }).observe(header, { attributes: true, attributeFilter: ["data-menu"] });
    }

    // --- sticky state + scroll-spy ------------------------------------------

    // Links that point at a section on this page: "/#features", "/tw#service" ...
    const links = Array.from(header.querySelectorAll<HTMLAnchorElement>("#nav-menu a.nav-link"));
    const targets = links
      .map((link) => {
        const url = new URL(link.getAttribute("href") ?? "", location.origin);
        if (url.pathname.replace(/\/$/, "") !== location.pathname.replace(/\/$/, "")) return null;
        const section = url.hash ? document.getElementById(url.hash.slice(1)) : document.getElementById("banner");
        return section ? { link, section } : null;
      })
      .filter((t): t is { link: HTMLAnchorElement; section: HTMLElement } => t !== null);

    let ticking = false;
    const update = () => {
      ticking = false;
      header.classList.toggle("header-sticky", window.scrollY > 8);

      if (!targets.length) return;
      const probe = window.scrollY + window.innerHeight * 0.35;
      let current = targets[0];
      for (const t of targets) {
        if (t.section.offsetTop <= probe) current = t;
      }
      for (const t of targets) {
        const active = t === current;
        t.link.classList.toggle("active", active);
        if (active) t.link.setAttribute("aria-current", "location");
        else t.link.removeAttribute("aria-current");
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true, signal });
    window.addEventListener("resize", onScroll, { passive: true, signal });
    update();
  }

  document.addEventListener("astro:page-load", initHeader);
</script>
