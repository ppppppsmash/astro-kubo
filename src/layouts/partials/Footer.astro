---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
import { contactHref as buildContactHref, t } from "@/lib/i18n";

const { copyright, corp_name, location, email, footer_description } = config.params;
const text = t(Astro.url.pathname);
const contactHref = buildContactHref(Astro.url.pathname, email);
---

<footer class="footer border-t border-border bg-white">
  <div class="container">
    <div class="grid gap-12 py-16 md:grid-cols-12 md:py-20">
      <div class="md:col-span-5">
        <Logo />
        <p class="mt-6 max-w-sm">{footer_description}</p>
      </div>

      <div class="md:col-span-4">
        <h2 class="footer-label">{text.company}</h2>
        <ul class="space-y-1">
          <li>{corp_name}</li>
          <li>{location}</li>
          <li><a href={`mailto:${email}`}>{email}</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class="footer-label">{text.links}</h2>
        <ul class="space-y-1">
          <li><a href={contactHref}>{text.contact}</a></li>
          {social.shop && (
            <li><a href={social.shop} target="_blank" rel="noopener noreferrer">{text.shop}</a></li>
          )}
          {social.instagram && (
            <li><a href={social.instagram} target="_blank" rel="noopener noreferrer">{text.instagram}</a></li>
          )}
        </ul>
      </div>
    </div>

    <div class="flex flex-col gap-2 border-t border-border py-6 text-[12px] tracking-[0.04em] text-light md:flex-row md:items-center md:justify-between">
      <p set:html={markdownify(copyright)} />
      <p class="uppercase tracking-[0.24em]">{text.madeIn}</p>
    </div>
  </div>
</footer>
