---
import Icon from "@/components/Icon.astro";
import { t } from "@/lib/i18n";
const text = t(Astro.url.pathname);
---

<button type="button" id="back-to-top" class="back-to-top" aria-label={text.backToTop}>
  <Icon name="arrow-align-top" class="h-4 w-4" md="hover" />
</button>

<script>
  import { replay, reducedMotion } from "@/lib/linemd";

  let controller: AbortController | null = null;

  function initBackToTop() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const button = document.getElementById("back-to-top");
    if (!button) return;

    const icon = button.querySelector<SVGSVGElement>("svg");
    const reduce = reducedMotion();
    let ticking = false;
    const update = () => {
      ticking = false;
      const show = window.scrollY > window.innerHeight * 0.8;
      const wasVisible = button.classList.contains("is-visible");
      button.classList.toggle("is-visible", show);
      // draw the arrow in each time the button appears
      if (show && !wasVisible && icon && !reduce) replay(icon);
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    button.addEventListener(
      "click",
      () => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
      },
      { signal },
    );
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    update();
  }

  document.addEventListener("astro:page-load", initBackToTop);
</script>
